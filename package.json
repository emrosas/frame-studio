{
  "name": "frame-studio",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Agent-authored procedural animation: every frame drawn in code on an HTML canvas.",
  "scripts": {
    "dev": "node tools/dev.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "render": "node tools/render/cli.ts frame",
    "export": "node tools/render/cli.ts export",
    "contact-sheet": "node tools/render/cli.ts contact-sheet",
    "desktop": "node tools/desktop/run.ts",
    "desktop:build": "node tools/desktop/package.ts",
    "desktop:check": "node tools/desktop/check.ts",
    "desktop:release": "node tools/desktop/release.ts",
    "typeface": "node tools/type/cli.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@napi-rs/canvas": "^1.0.9",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "es-module-lexer": "^2.3.2",
    "fontkit": "^2.0.4",
    "playwright": "1.63.0",
    "rolldown": "^1.2.9",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "4.6.5"
  },
  "dependencies": {
    "gifenc": "1.0.3",
    "mediabunny": "1.59.1"
  }
}
