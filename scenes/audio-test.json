    },
    {
      "id": "fly",
      "rig": "star",
      "params": { "x": 440, "y": 180, "outerRadius": 50, "innerRadius": 22, "fill": "#3d6b8c", "opacity": 0.25 },
      "tracks": [
        { "param": "opacity", "keys": [ { "t": 2.1, "v": 0.25 }, { "t": 2.2, "v": 1 }, { "t": 3.2, "v": 1 }, { "t": 3.3, "v": 0.25 } ] },
        { "param": "rotation", "keys": [ { "t": 2.2, "v": 0 }, { "t": 3.2, "v": 720, "ease": "inOutSine" } ] }
