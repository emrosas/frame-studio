    { "id": "buzz", "generator": "buzz", "start": 2.2, "end": 3.2, "params": { "pitch": 180, "gain": 0.2 } },
    { "id": "bed", "generator": "pad", "start": 2, "end": 4, "params": { "note": 110, "chord": "minor", "gain": 0.15, "attack": 0.8, "release": 0.8 } }
