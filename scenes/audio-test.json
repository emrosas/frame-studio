{
  "id": "audio-test",
  "fps": 30,
  "duration": 4,
  "size": [640, 360],
  "seed": 11,
  "background": { "rig": "paper", "params": { "tone": "#f4efe6" } },
  "layers": [
    {
      "id": "beat",
      "rig": "circle",
      "params": { "x": 200, "y": 180, "radius": 40, "fill": "#e05a4f" },
      "overrides": [
        { "from": 15, "to": 18, "params": { "radius": 70 } },
        { "from": 30, "to": 33, "params": { "radius": 70 } },
        { "from": 45, "to": 48, "params": { "radius": 70 } }
